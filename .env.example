# Copy to .env (Docker) or /etc/agentbridge/agentbridge.env (systemd); chmod 600.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTBRIDGE_ADMIN_TOKEN=
AGENTBRIDGE_SESSION_SECRET=
# Only if the GitHub webhook is configured:
GITHUB_WEBHOOK_SECRET=
# Optional Mindlogic adapter (disabled by default):
# MINDLOGIC_API_KEY=

# Docker Compose only: must match the host `agentbridge` user (id -u agentbridge / id -g agentbridge)
AB_UID=10001
AB_GID=10001
AB_DATA_DIR=/var/lib/agentbridge
AB_CONFIG_DIR=/etc/agentbridge
AB_REPOS_DIR=/srv/agentbridge/repos
